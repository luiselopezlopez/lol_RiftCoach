<Window x:Class="LoLCoach.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:controls="clr-namespace:LoLCoach.Controls"
        Title="Rift Coach" Width="1120" Height="840" MinWidth="760" MinHeight="640"
        Background="#010A13" Foreground="#F0E6D2" FontFamily="Spiegel, Segoe UI" FontSize="15"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Closing="OnClosing" SourceInitialized="OnSourceInitialized">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Hextech.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolVisibility" />
      <controls:EmptyToVisibleConverter x:Key="EmptyVisibility" />
      <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Style.Triggers><DataTrigger Binding="{Binding IsHighlighted}" Value="True">
          <Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{Binding HighlightColor}"/>
          <Setter Property="FontFamily" Value="{StaticResource NumberFont}"/>
        </DataTrigger></Style.Triggers>
      </Style>
      <Style x:Key="AdviceText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NumberFont}"/><Setter Property="FontSize" Value="21"/><Setter Property="LineHeight" Value="29"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/>
        <Style.Triggers><DataTrigger Binding="{Binding IsLatest}" Value="True">
          <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
          <Setter Property="FontSize" Value="54"/><Setter Property="LineHeight" Value="67.5"/>
          <Setter Property="Foreground" Value="{StaticResource Gold2Brush}"/><Setter Property="FontWeight" Value="Bold"/>
        </DataTrigger></Style.Triggers>
      </Style>
      <Style x:Key="QuizPanel" TargetType="StackPanel">
        <Setter Property="Visibility" Value="Visible"/>
        <Style.Triggers><DataTrigger Binding="{Binding ShowResults}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
      </Style>
      <!-- Small framed tile for one vital stat. -->
      <Style x:Key="StatTile" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource VoidBrush}"/><Setter Property="BorderBrush" Value="{StaticResource Gold5Brush}"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,6,10,8"/><Setter Property="Margin" Value="0,0,6,0"/>
      </Style>
      <Style x:Key="StatNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NumberFont}"/><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <!-- Header -->
    <Grid Background="{StaticResource HeaderBackgroundBrush}">
      <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource GoldFadeBothBrush}"/>
      <DockPanel Margin="18,10,20,10">
        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="24,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding ProfileLabel}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="15"
                     Foreground="{StaticResource Gold1Brush}" TextAlignment="Right"/>
          <TextBlock Text="{Binding Status}" Style="{StaticResource Label}" TextAlignment="Right" MaxWidth="400"/>
        </StackPanel>
        <Viewbox Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Center">
          <Canvas Width="34" Height="34">
            <Path Data="M17,1 L33,17 L17,33 L1,17 Z" Fill="{StaticResource VoidBrush}" Stroke="{StaticResource GoldMetalBrush}" StrokeThickness="2"/>
            <Path Data="M17,6 L28,17 L17,28 L6,17 Z" Stroke="{StaticResource Gold4Brush}" StrokeThickness="1"/>
            <Path Data="M17,10.5 L23.5,17 L17,23.5 L10.5,17 Z" Fill="{StaticResource HextechCoreBrush}">
              <Path.Effect><DropShadowEffect Color="#0AC8B9" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/></Path.Effect>
            </Path>
          </Canvas>
        </Viewbox>
        <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
          <TextBlock Text="RIFT COACH" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource GoldMetalBrush}" TextWrapping="NoWrap"/>
          <TextBlock Text="ENTRENADOR DE LA GRIETA" Style="{StaticResource Caption}" FontSize="10" Foreground="{StaticResource Blue2Brush}" Margin="1,0,0,0"/>
        </StackPanel>
        <Menu x:Name="MainMenu" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="14">
          <MenuItem Header="_Ventanas" Padding="10,6">
            <MenuItem Header="Campeón y miniguía" IsCheckable="True" IsChecked="{Binding IsOpen, ElementName=ChampionPanel}"/>
            <MenuItem Header="Entrenamiento" IsCheckable="True" IsChecked="{Binding IsOpen, ElementName=TrainingPanel}"/>
            <MenuItem Header="Campeones" IsCheckable="True" IsChecked="{Binding IsOpen, ElementName=ChampionsPanel}"/>
            <MenuItem Header="Sesión y partida" IsCheckable="True" IsChecked="{Binding IsOpen, ElementName=SessionPanel}"/>
            <MenuItem Header="Recomendación de campeón" IsCheckable="True" IsChecked="{Binding IsOpen, ElementName=RecommendationPanel}"/>
            <Separator/>
            <MenuItem Header="Restablecer disposición" Click="OnResetLayout"/>
          </MenuItem>
        </Menu>
      </DockPanel>
    </Grid>

    <!-- Workspace with hextech backdrop -->
    <Border Grid.Row="1" Background="{StaticResource WorkspaceBrush}"/>
    <Rectangle Grid.Row="1" Fill="{StaticResource HexPatternBrush}" IsHitTestVisible="False"/>
    <Canvas x:Name="Workspace" Grid.Row="1" ClipToBounds="True" Background="Transparent" SizeChanged="OnWorkspaceSizeChanged">

      <controls:FloatingPanel x:Name="ChampionPanel" Title="Campeón y miniguía" Canvas.Left="8" Canvas.Top="8" Width="330" Height="400">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="CAMPEÓN ELEGIDO" Style="{StaticResource Caption}"/>
            <ComboBox ItemsSource="{Binding Champions}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedChampion}" AutomationProperties.Name="Campeón elegido"/>
            <Expander x:Name="MiniGuidePanel" Header="Miniguía de habilidades" IsExpanded="True" Margin="0,0,0,12">
              <Grid>
                <TextBlock Text="{Binding MiniGuide}" FontSize="15" LineHeight="22" Margin="0,6,0,8"/>
                <TextBlock Text="La miniguía de habilidades aparecerá al detectar la partida." Style="{StaticResource Label}" FontStyle="Italic" Margin="0,6,0,8">
                  <TextBlock.Visibility><Binding Path="MiniGuide" Converter="{StaticResource EmptyVisibility}"/></TextBlock.Visibility>
                </TextBlock>
              </Grid>
            </Expander>
            <TextBlock Text="TU CAMPEÓN EN PARTIDA" Style="{StaticResource Caption}"/>
            <TextBlock Text="{Binding OwnChampion}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold" Margin="0,2,0,0"
                       Foreground="{StaticResource GoldTextBrush}"/>
            <TextBlock Text="{Binding GamePhase}" Style="{StaticResource Label}" Foreground="{StaticResource Blue2Brush}" Margin="0,0,0,10"/>
            <UniformGrid Columns="3" Margin="0,0,-6,8">
              <Border Style="{StaticResource StatTile}"><StackPanel>
                <TextBlock Text="NIVEL" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="OwnLevelValue" Text="{Binding OwnLevel}" Style="{StaticResource StatNumber}" FontSize="22" Foreground="{StaticResource Blue2Brush}"/>
              </StackPanel></Border>
              <Border Style="{StaticResource StatTile}"><StackPanel>
                <TextBlock Text="VIDA" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="OwnHealthValue" Text="{Binding OwnHealth}" Style="{StaticResource StatNumber}" Foreground="{Binding OwnHealthColor}"/>
              </StackPanel></Border>
              <Border Style="{StaticResource StatTile}"><StackPanel>
                <TextBlock Text="ORO" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="OwnGoldValue" Text="{Binding OwnGold}" Style="{StaticResource StatNumber}" Foreground="{StaticResource Gold3Brush}"/>
              </StackPanel></Border>
            </UniformGrid>
            <ProgressBar Style="{StaticResource HealthBar}" Value="{Binding OwnHealthRatio, Mode=OneWay}" Foreground="{Binding OwnHealthColor}"
                         Margin="0,0,0,10" AutomationProperties.Name="Barra de vida"/>
            <Expander x:Name="OwnAttributes" Header="Tus atributos" IsExpanded="True">
              <ItemsControl ItemsSource="{Binding ApiFields}">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Border BorderBrush="{StaticResource Grey3Brush}" BorderThickness="0,0,0,1" Padding="0,5">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                      <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource StatValue}"/>
                    </Grid>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </controls:FloatingPanel>

      <controls:FloatingPanel x:Name="TrainingPanel" Title="Entrenamiento" Canvas.Left="346" Canvas.Top="8" Width="440" Height="400">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top">
            <Path Data="M4,0 L8,4 L4,8 L0,4 Z" Fill="{StaticResource Blue2Brush}" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding AdviceState}" Style="{StaticResource Label}" Foreground="{StaticResource Blue1Brush}"/>
          </DockPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding AgeLabel}" Style="{StaticResource Label}" MinHeight="22"/>
          <ScrollViewer x:Name="AdviceHistoryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,8" AutomationProperties.Name="Historial de consejos">
            <ItemsControl ItemsSource="{Binding Messages}" SizeChanged="OnHistorySizeChanged">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border x:Name="Item" BorderBrush="{StaticResource Grey3Brush}" BorderThickness="0,0,0,1" Padding="0,12,0,16" Margin="0,0,10,0">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                      <TextBlock Text="{Binding TimeLabel}" Style="{StaticResource Label}" DockPanel.Dock="Right"/>
                      <TextBlock Text="{Binding State, Converter={StaticResource UpperCase}}" Style="{StaticResource Caption}" Foreground="{StaticResource Blue2Brush}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Text}" Style="{StaticResource AdviceText}"/>
                  </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsLatest}" Value="True">
                    <Setter TargetName="Item" Property="Background" Value="{StaticResource LatestAdviceBrush}"/>
                    <Setter TargetName="Item" Property="Padding" Value="14,12,8,18"/>
                    <Setter TargetName="Item" Property="BorderBrush" Value="{StaticResource Gold4Brush}"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </controls:FloatingPanel>

      <controls:FloatingPanel x:Name="SessionPanel" Title="Sesión, partida y depuración" Canvas.Left="794" Canvas.Top="8" Width="300" Height="400" MinWidth="280">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top">
            <Button Command="{Binding StartCommand}" Style="{StaticResource Primary}" ToolTip="Iniciar sesión"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="Play" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="INICIAR"/></StackPanel></Button>
            <Button Command="{Binding StopCommand}" ToolTip="Pausar y cancelar solicitudes"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="Pause" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="PAUSAR"/></StackPanel></Button>
          </WrapPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding StateLabel}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
          <TabControl x:Name="SessionTabs">
            <TabControl.Resources>
              <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="32"/><Setter Property="BorderThickness" Value="0"/></Style>
            </TabControl.Resources>
            <TabItem Header="Sesión">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,10,4,4">
                <StackPanel>
                  <CheckBox IsChecked="{Binding AutomaticStartEnabled}" IsEnabled="{Binding CanChangeMode}"><TextBlock Text="Inicio automático al detectar partida"/></CheckBox>
                  <CheckBox IsChecked="{Binding ContinuousSending}" IsEnabled="{Binding CanChangeMode}"><TextBlock Text="Envío continuo · sin límite de solicitudes"/></CheckBox>
                  <CheckBox x:Name="AllowUnverifiedBotOpponentsForDebuggingCheckBox"
                            IsChecked="{Binding AllowUnverifiedBotOpponentsForDebugging}"
                            IsEnabled="{Binding CanChangeMode}" Margin="0,8,0,0">
                    <TextBlock Text="Depuración: omitir verificación de bots" TextWrapping="Wrap"/>
                  </CheckBox>
                  <TextBlock Text="Puede permitir sesiones PvP. Úsalo solo para pruebas controladas."
                             Style="{StaticResource Label}" Foreground="{StaticResource Gold2Brush}"
                             TextWrapping="Wrap" Margin="22,0,0,10"/>
                  <TextBlock Text="MODELO" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding ModelName}" Margin="0,2,0,2" FontFamily="{StaticResource NumberFont}"/>
                  <TextBlock Text="{Binding ModelStatus}" Style="{StaticResource Label}" Foreground="{StaticResource Blue2Brush}" Margin="0,0,0,14"/>
                  <TextBlock Margin="0,0,0,14"><Run Text="Solicitudes de sesión: " Foreground="{StaticResource TextSecondaryBrush}"/><Run Text="{Binding Requests, Mode=OneWay}" FontFamily="{StaticResource NumberFont}" FontWeight="Bold" Foreground="{StaticResource Gold2Brush}"/></TextBlock>
                  <CheckBox IsChecked="{Binding VoiceEnabled}" IsEnabled="{Binding HasSpanishVoice}" Content="Autoplay de voz en español"/>
                  <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" AutomationProperties.Name="Voz española"/>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Volume}" FontFamily="{StaticResource NumberFont}" Foreground="{StaticResource Gold2Brush}"/>
                    <TextBlock Text="VOLUMEN" Style="{StaticResource Caption}"/>
                  </DockPanel>
                  <Slider Minimum="0" Maximum="100" Value="{Binding Volume}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,6,0,8" AutomationProperties.Name="Volumen"/>
                  <TextBlock Text="{Binding VoiceStatus}" Style="{StaticResource Label}"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="Partida">
              <DockPanel Margin="4,10,4,4">
                <TextBlock DockPanel.Dock="Top" Text="{Binding ApiStatus}" Foreground="{StaticResource Blue1Brush}" Margin="0,0,0,4"/>
                <TextBlock DockPanel.Dock="Top" Text="{Binding ApiLastUpdate, StringFormat=Última actualización: {0}}" Style="{StaticResource Label}" Margin="0,0,0,10"/>
                <DataGrid ItemsSource="{Binding ApiFields}" AutomationProperties.Name="Información recuperada de LoL">
                  <DataGrid.Columns><DataGridTextColumn Header="Dato" Binding="{Binding Name}" Width="Auto" MinWidth="110"/><DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="*"/></DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </TabItem>
            <TabItem Header="Depuración">
              <DockPanel Margin="4,10,4,4">
                <DockPanel DockPanel.Dock="Top">
                  <Button DockPanel.Dock="Right" Command="{Binding ClearDiagnosticsCommand}" ToolTip="Limpiar registros" MinHeight="32" Padding="10,6" Margin="0,0,0,8"><icons:PackIconMaterial Kind="DeleteOutline"/></Button>
                  <TextBlock Text="CONSULTAS A LAS API" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                  <TextBlock Text="{Binding LocalSettingsPath}" Style="{StaticResource Label}"/>
                  <TextBlock Text="{Binding ModelReply}" Margin="0,6,0,0" FontSize="13"/>
                </StackPanel>
                <TabControl>
                  <TabItem Header="LoL"><DataGrid ItemsSource="{Binding LolDiagnostics}" AutomationProperties.Name="Consultas a la API de LoL"><DataGrid.Columns>
                    <DataGridTextColumn Header="Hora" Binding="{Binding TimeLabel}" Width="74"/><DataGridTextColumn Header="Método" Binding="{Binding Method}" Width="70"/><DataGridTextColumn Header="Ruta" Binding="{Binding Path}" Width="*" MinWidth="160"/><DataGridTextColumn Header="HTTP" Binding="{Binding StatusLabel}" Width="60"/><DataGridTextColumn Header="Tiempo" Binding="{Binding DurationLabel}" Width="85"/><DataGridTextColumn Header="Resultado" Binding="{Binding Result}" Width="180"/>
                  </DataGrid.Columns></DataGrid></TabItem>
                  <TabItem Header="Azure OpenAI"><DataGrid ItemsSource="{Binding ModelDiagnostics}" AutomationProperties.Name="Consultas a la API de Azure OpenAI"><DataGrid.Columns>
                    <DataGridTextColumn Header="Hora" Binding="{Binding TimeLabel}" Width="74"/><DataGridTextColumn Header="Método" Binding="{Binding Method}" Width="70"/><DataGridTextColumn Header="Ruta" Binding="{Binding Path}" Width="*" MinWidth="160"/><DataGridTextColumn Header="HTTP" Binding="{Binding StatusLabel}" Width="60"/><DataGridTextColumn Header="Tiempo" Binding="{Binding DurationLabel}" Width="85"/><DataGridTextColumn Header="Resultado" Binding="{Binding Result}" Width="180"/>
                  </DataGrid.Columns></DataGrid></TabItem>
                </TabControl>
              </DockPanel>
            </TabItem>
            <TabItem Header="Captura">
              <DockPanel Margin="4,10,4,4">
                <TextBlock DockPanel.Dock="Top" Text="{Binding PayloadLabel, StringFormat=Imagen enviada: {0}}" Style="{StaticResource Label}"/>
                <TextBlock DockPanel.Dock="Top" Text="{Binding LatencyLabel, StringFormat=Frase completa: {0}}" Style="{StaticResource Label}" Margin="0,4,0,8"/>
                <Border BorderBrush="{StaticResource Gold4Brush}" BorderThickness="1" Background="{StaticResource VoidBrush}" Padding="2">
                  <Grid>
                    <TextBlock Text="Sin captura activa" Style="{StaticResource Label}" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock.Visibility><Binding Path="Scene" Converter="{StaticResource EmptyVisibility}"/></TextBlock.Visibility>
                    </TextBlock>
                    <Image Source="{Binding Scene}" Stretch="Uniform" AutomationProperties.Name="Captura de pantalla enviada"/>
                  </Grid>
                </Border>
              </DockPanel>
            </TabItem>
          </TabControl>
        </DockPanel>
      </controls:FloatingPanel>

      <controls:FloatingPanel x:Name="ChampionsPanel" Title="Campeones" Canvas.Left="8" Canvas.Top="416" Width="1086" Height="240" MinWidth="320">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" Margin="0,0,0,8">
            <Run Text="{Binding RosterStatus, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ApiLastUpdate, Mode=OneWay, StringFormat=Actualizado: {0}}"/>
          </TextBlock>
          <ScrollViewer x:Name="PlayersScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Marcador de todos los campeones">
            <ItemsControl ItemsSource="{Binding Players}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border x:Name="Column" Width="190" Margin="0,0,10,8" Padding="12,10" BorderThickness="1,3,1,1"
                        BorderBrush="{StaticResource Blue2Brush}" Background="{StaticResource CardBackgroundBrush}">
                  <StackPanel ToolTip="{Binding Details}">
                    <TextBlock Text="{Binding Heading}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource Blue1Brush}">
                      <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                        <DataTrigger Binding="{Binding Player.IsOwn}" Value="True"><Setter Property="Foreground" Value="{StaticResource Gold1Brush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Player.Relation}" Value="Rival"><Setter Property="Foreground" Value="{StaticResource RedBrush}"/></DataTrigger>
                      </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock FontSize="14" Margin="0,4,0,4"><Run Text="Nv. " Foreground="{StaticResource TextSecondaryBrush}"/><Run Text="{Binding Player.Level, Mode=OneWay, TargetNullValue=-}" FontFamily="{StaticResource NumberFont}" FontWeight="Bold" Foreground="{StaticResource Blue2Brush}"/><Run Text="{Binding ScoreDetails, Mode=OneWay}"/></TextBlock>
                    <TextBlock Text="{Binding Details}" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Items}" Style="{StaticResource Label}"/>
                  </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Player.Relation}" Value="Rival"><Setter TargetName="Column" Property="BorderBrush" Value="{StaticResource RedBrush}"/><Setter TargetName="Column" Property="Background" Value="{StaticResource RivalCardBackgroundBrush}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Player.IsOwn}" Value="True"><Setter TargetName="Column" Property="BorderBrush" Value="{StaticResource GoldBorderBrush}"/><Setter TargetName="Column" Property="Background" Value="{StaticResource OwnCardBackgroundBrush}"/></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </controls:FloatingPanel>

      <controls:FloatingPanel x:Name="RecommendationPanel" Title="Recomendación de campeón y posición" Canvas.Left="180" Canvas.Top="30" Width="680" Height="560" MinWidth="320">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,8,0">
            <StackPanel Style="{StaticResource QuizPanel}">
              <TextBlock Text="{Binding QuestionProgress, Converter={StaticResource UpperCase}}" Style="{StaticResource Caption}" Foreground="{StaticResource Blue2Brush}" Margin="0,0,0,10"/>
              <TextBlock Text="{Binding CurrentQuestion.Question.Text}" Style="{StaticResource Heading}"/>
              <ListBox ItemsSource="{Binding CurrentQuestion.Question.Options}" SelectedIndex="{Binding CurrentQuestion.SelectedIndex, Mode=TwoWay}"
                       AutomationProperties.Name="Respuestas del cuestionario" ItemContainerStyle="{StaticResource QuizOption}" Margin="0,8,0,20">
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}"/></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel>
                <Button Command="{Binding PreviousQuestionCommand}" ToolTip="Pregunta anterior"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ChevronLeft" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="ANTERIOR"/></StackPanel></Button>
                <Button Command="{Binding NextQuestionCommand}" Style="{StaticResource Primary}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding NextLabel, Converter={StaticResource UpperCase}}"/><icons:PackIconMaterial Kind="ChevronRight" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
              </WrapPanel>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowResults, Converter={StaticResource BoolVisibility}}">
              <TextBlock Text="Tu punto de partida" Style="{StaticResource Heading}"/>
              <TextBlock Text="{Binding ResultSummary}" LineHeight="22" Margin="0,0,0,18"/>
              <ItemsControl ItemsSource="{Binding Recommendations}" Margin="0,0,0,12">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource GoldBorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,10,10" Width="200">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <Grid Width="88" Height="88" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <Ellipse Fill="{StaticResource VoidBrush}" Stroke="{StaticResource GoldMetalBrush}" StrokeThickness="3"/>
                        <Ellipse Margin="5"><Ellipse.Fill><ImageBrush ImageSource="{Binding Portrait}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
                      </Grid>
                      <TextBlock Grid.Row="1" Text="{Binding Choice.Name}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="21" Foreground="{StaticResource GoldTextBrush}"/>
                      <TextBlock Grid.Row="2" Text="{Binding Role, Converter={StaticResource UpperCase}}" Style="{StaticResource Caption}" Foreground="{StaticResource Blue2Brush}" Margin="0,2,0,10"/>
                      <StackPanel Grid.Row="3"><TextBlock Text="{Binding Choice.Reason}" FontSize="14"/><TextBlock Text="{Binding Choice.Difficulty, StringFormat=Dificultad: {0}}" Style="{StaticResource Label}" Margin="0,10,0,12"/></StackPanel>
                      <Button Grid.Row="4" Content="ELEGIR" Margin="0" Command="{Binding DataContext.ChooseChampionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                    </Grid>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <WrapPanel><Button Content="USAR ESTE PERFIL" Style="{StaticResource Primary}" Command="{Binding SaveProfileCommand}"/><Button Content="REPETIR CUESTIONARIO" Command="{Binding RepeatQuizCommand}"/></WrapPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </controls:FloatingPanel>
    </Canvas>

    <!-- Footer -->
    <Border Grid.Row="2" Background="{StaticResource VoidBrush}" BorderBrush="{StaticResource Gold5Brush}" BorderThickness="0,1,0,0" Padding="20,8">
      <StackPanel><TextBlock Text="{Binding LiveRestriction}" FontSize="13" Foreground="{StaticResource Gold3Brush}"/>
        <TextBlock FontSize="11" Foreground="{StaticResource Grey15Brush}" Margin="0,4,0,0" Text="Rift Coach isn't endorsed by Riot Games and doesn't reflect the views or opinions of Riot Games or anyone officially involved in producing or managing Riot Games properties. Riot Games, and all associated properties are trademarks or registered trademarks of Riot Games, Inc."/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
